# Required startup classification: local or hosted.
GREENLINE_MODE=local
# Hosted images bake in the full source commit. Do not override it at runtime.
# GREENLINE_RELEASE_SHA=replace_with_full_40_character_lowercase_commit_sha
# Clerk secret key used to verify frontend session tokens.
CLERK_SECRET_KEY=sk_test_replace_me
# Any Hosted secret can instead use an absolute mounted-file source. Never set
# both the direct and _FILE form.
# CLERK_SECRET_KEY_FILE=/run/secrets/clerk_secret_key
# Comma-separated origins allowed in the Clerk azp claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Hosted Mode only: immutable, preloaded Challenge Run images. Mutable tags
# are rejected, and images are never pulled while handling a run.
# GREENLINE_PYTHON_EXECUTION_IMAGE=registry.example.com/greenline-python@sha256:replace_with_64_hex_characters
# GREENLINE_NODE_EXECUTION_IMAGE=registry.example.com/greenline-node@sha256:replace_with_64_hex_characters
# GREENLINE_DOCKER_BINARY=docker
# Absolute path shared at the same path with the worker's dedicated Docker daemon.
# GREENLINE_RUN_BUNDLE_DIR=/run-bundles
# Per-container RAM limit in MiB. Valid range: 128-4096. Size this together
# with worker concurrency so the host retains memory for Docker and the OS.
# GREENLINE_RUN_MEMORY_MIB=512
# GREENLINE_WORKER_CONCURRENCY=4
# Hosted Mode only: PostgreSQL database migrated with backend/migrations/*.sql.
# GREENLINE_DATABASE_URL=postgresql://greenline_app:replace_me@db.example.com/greenline?sslmode=verify-full
# GREENLINE_DATABASE_URL_FILE=/run/secrets/database_url
# Hosted Mode structured security logs pseudonymize Clerk subjects with this key.
# Use at least 32 bytes and keep it stable across replicas and rotations.
# GREENLINE_LOG_HMAC_KEY_FILE=/run/secrets/security_log_hmac_key
# Explicit proxy IPs/networks trusted to supply X-Forwarded-* headers. Wildcard
# trust is rejected. Start Hosted Mode with `python serve.py`; it sets the
# internal launcher marker after applying this allowlist to Uvicorn.
# GREENLINE_TRUSTED_PROXY_CIDRS=10.0.0.0/8,127.0.0.1/32
# GREENLINE_HOST=0.0.0.0
# GREENLINE_PORT=8000
# Hosted Mode abuse-control policy. Defaults shown; set explicitly in deployment.
# GREENLINE_MAX_REQUEST_BYTES=262144
# GREENLINE_REQUESTS_PER_MINUTE=240
# GREENLINE_MUTATIONS_PER_MINUTE=30
# GREENLINE_RUNS_PER_MINUTE=6
# GREENLINE_CONTENT_READS_PER_MINUTE=120
# GREENLINE_DISTINCT_CHALLENGES_PER_HOUR=20
# GREENLINE_SOLUTIONS_PER_HOUR=5
# GREENLINE_MAX_ACTIVE_RUNS=20
# GREENLINE_MAX_ACTIVE_RUNS_PER_USER=1
# GREENLINE_AUDIT_RETENTION_DAYS=30
# Test/CI only: disposable migrated PostgreSQL database for Adapter contracts.
# GREENLINE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/greenline_test
