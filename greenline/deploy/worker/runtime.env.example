# Copy to runtime.env. The socket group is host-specific:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# The source and target must be this same absolute host path because the worker
# asks the host Docker daemon to mount each disposable Run Bundle.
RUN_BUNDLE_DIR=/srv/makeitgreen/run-bundles

# A 1 GiB staging worker starts at one 384 MiB execution slot. Raise this only
# after the named capacity scenarios pass without OOM or swap pressure.
RUN_MEMORY_MIB=384
WORKER_CONCURRENCY=1

# This is the shared queue/admission cap, not container concurrency. It must
# match the application host and every worker host.
MAX_ACTIVE_RUNS=100
MAX_ACTIVE_RUNS_PER_USER=1

MAX_REQUEST_BYTES=262144
REQUESTS_PER_MINUTE=240
MUTATIONS_PER_MINUTE=30
RUNS_PER_MINUTE=6
CONTENT_READS_PER_MINUTE=120
DISTINCT_CHALLENGES_PER_HOUR=20
SOLUTIONS_PER_HOUR=5
AUDIT_RETENTION_DAYS=30
