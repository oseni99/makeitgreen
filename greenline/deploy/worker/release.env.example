# Copy to release.env. All three references must come from the same successful
# greenline-release-<commit> manifest and must retain their @sha256 digests.
EXECUTION_WORKER_IMAGE=ghcr.io/OWNER/REPOSITORY-execution-worker@sha256:REPLACE_WITH_64_HEX_CHARACTERS
PYTHON_EXECUTION_IMAGE=ghcr.io/OWNER/REPOSITORY-python-execution@sha256:REPLACE_WITH_64_HEX_CHARACTERS
NODE_EXECUTION_IMAGE=ghcr.io/OWNER/REPOSITORY-node-execution@sha256:REPLACE_WITH_64_HEX_CHARACTERS
